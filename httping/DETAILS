          MODULE=httping
         VERSION=4.4.0
          SOURCE=HTTPing-$VERSION.tar.gz
SOURCE_DIRECTORY=$BUILD_DIRECTORY/HTTPing-$VERSION
 SOURCE_URL_FULL=https://github.com/folkertvanheusden/HTTPing/archive/refs/tags/v${VERSION}.tar.gz
      SOURCE_VFY=sha256:87fa2da5ac83c4a0edf4086161815a632df38e1cc230e1e8a24a8114c09da8fd
        WEB_SITE=https://www.vanheusden.com/httping/
            TYPE=cmake
         ENTERED=20241009
         UPDATED=20260918
           SHORT="Ping an HTTP server"

cat << EOF
Httping is like 'ping' but for http-requests.
Give it an url, and it'll show you how long it takes to connect, send a request
and retrieve the reply (only the headers). Be aware that the transmission
across the network also takes time! So it measures the latency of the
webserver + network.
EOF
